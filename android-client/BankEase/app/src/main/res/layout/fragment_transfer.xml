<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/screenNavigationButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to home"
                android:gravity="center"
                android:text="‹"
                android:textColor="#1266D5"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Transfer Money"
                android:textColor="#102344"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Who would you like to pay?"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Select Recipient -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Select Recipient"
            android:textColor="#102344"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSourceAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

        </RadioGroup>

        <EditText
            android:id="@+id/etRecipientAccountNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:hint="Recipient account number"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#102344" />

        <!-- Amount -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Enter Amount (₹)"
            android:textColor="#102344"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTransferAmount"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="₹ 0.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="#1266D5"
            android:textColorHint="#94A3B8"
            android:textSize="24sp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etTransferDescription"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:hint="Description (optional)"
            android:inputType="textCapSentences"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#102344" />

        <TextView
            android:id="@+id/tvTransferError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#B42318"
            android:visibility="gone" />

        <!-- Review Button -->
        <Button
            android:id="@+id/btnReviewTransfer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#1266D5"
            android:text="Review Transfer  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Security Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Transfers are processed and recorded by your bank server."
            android:textColor="#64748B"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="#DCE5F0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Send to friend"
            android:textColor="#102344"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Save an account once, then send using the verified account holder name."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRecipientsState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRetryRecipients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:textAllCaps="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/savedRecipientsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Save a recipient"
            android:textColor="#102344"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNewRecipientAccountNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="Recipient account number"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#102344" />

        <TextView
            android:id="@+id/tvRecipientManagementError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B42318"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveRecipient"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#DCEBFF"
            android:text="Save recipient"
            android:textAllCaps="false"
            android:textColor="#1266D5"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
