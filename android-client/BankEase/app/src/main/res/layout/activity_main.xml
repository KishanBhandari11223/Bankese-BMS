<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FF"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F8FF">

        <FrameLayout
            android:id="@+id/mainFragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#F4F8FF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/drawerAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="#DCEBFF"
            android:gravity="center"
            android:text="?"
            android:textColor="#1266D5"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/drawerUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#102344"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="#E7EDF5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="BANKING"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navDashboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="#1266D5" />

        <Button
            android:id="@+id/navAccounts"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="Accounts"
            android:textAllCaps="false"
            android:textColor="#1266D5" />

        <Button
            android:id="@+id/navHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="Activity"
            android:textAllCaps="false"
            android:textColor="#1266D5" />

        <Button
            android:id="@+id/navProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="Profile"
            android:textAllCaps="false"
            android:textColor="#1266D5" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#E7EDF5" />

        <Button
            android:id="@+id/navSignOut"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#FFF1F0"
            android:gravity="start|center_vertical"
            android:text="Sign out"
            android:textAllCaps="false"
            android:textColor="#B42318" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>